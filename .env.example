# Copie este arquivo para ".env" e preencha.

# Chave da Google Maps Embed API (para o Street View).
# Sem chave, o totem mostra a imagem "Street View indisponível no momento".
VITE_GOOGLE_MAPS_KEY=

# (Opcional) Endereço para onde o QR Code de cada local aponta.
# O totem acrescenta ?local=<id>&lang=<idioma>. Se vazio, usa config.qrUrlBase do data/locais.json.
VITE_QR_URL_BASE=
